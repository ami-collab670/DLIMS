{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.onrender.com https://*.up.railway.app http://localhost:1337 http://127.0.0.1:1337"
        }
      ]
    }
  ]
}
